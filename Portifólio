@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700;800&display=swap');



:root {

  --fundo: #080b12;

  --texto: #f5f5f5;

  --dourado: #d4af37;

  --vermelho: #790d19;

  --azul: #101e38;

  --linha: #293246;

  --cinza: #aab2c0;

}



html { scroll-behavior: smooth; scroll-padding-top: 75px; }



body {

  background: var(--fundo);

  color: var(--texto);

  font-family: 'DM Sans', Arial, sans-serif;

}



.navbar {

  background: #05070c;

  border-bottom: 1px solid var(--linha);

  padding: 14px 0;

}



.navbar-brand { font-size: 30px; font-weight: 800; color: white; }

.navbar-brand span, footer span, .hero h1 span, h2 span { color: var(--dourado); }

.nav-link { color: white; font-size: 14px; margin-left: 15px; }

.nav-link:hover { color: var(--dourado); }

.navbar-toggler { background: var(--dourado); }



.hero {

  padding: 80px 0;

  overflow: hidden;

  background: linear-gradient(120deg, #080b12, #101e38);

}



.etiqueta {

  font: 11px 'DM Mono', monospace;

  letter-spacing: 1.5px;

  color: var(--dourado);

  margin-bottom: 18px;

}



.hero h1 {

  font-size: clamp(38px, 5.5vw, 70px);

  font-weight: 800;

  letter-spacing: -3px;

  line-height: 1.1;

}



.hero h5 { margin-top: 20px; color: var(--dourado); }



.apresentacao {

  max-width: 430px;

  color: var(--cinza);

  line-height: 1.8;

  margin: 20px 0;

}



.botao {

  display: inline-block;

  padding: 13px 18px;

  background: var(--dourado);

  color: #080b12;

  border: 1px solid var(--dourado);

  text-decoration: none;

  font-size: 13px;

  font-weight: 700;

  transition: 0.3s;

}



.botao:hover {

  background: var(--vermelho);

  border-color: var(--vermelho);

  color: white;

}



.desenho {

  height: 300px;

  max-width: 300px;

  margin: auto;

  background: var(--azul);

  position: relative;

  overflow: hidden;

  border: 1px solid #354765;

  border-radius: 48% 48% 3px 3px;

}



.sol {

  width: 130px;

  height: 130px;

  border-radius: 50%;

  background: var(--dourado);

  position: absolute;

  top: 70px;

  left: 50%;

  transform: translateX(-50%);

}



.orbita {

  position: absolute;

  width: 220px;

  height: 220px;

  border: 1px solid var(--vermelho);

  border-radius: 50%;

  top: 30px;

  left: 50%;

  transform: translateX(-50%) rotate(-30deg);

}



.simbolo {

  position: absolute;

  top: 100px;

  left: 50%;

  transform: translateX(-50%);

  color: #080b12;

  font-size: 50px;

  font-weight: bold;

}



.desenho small {

  position: absolute;

  bottom: 18px;

  left: 18px;

  font: 10px 'DM Mono', monospace;

  color: white;

}



.secao { padding: 70px 0; border-top: 1px solid var(--linha); }

.secao h2, .contato h2 { font-size: clamp(29px, 4vw, 42px); font-weight: 800; letter-spacing: -1px; }

.secao p:not(.etiqueta) { line-height: 1.8; color: var(--cinza); }



.assinatura {

  display: inline-block;

  border-bottom: 2px solid var(--dourado);

  padding-bottom: 5px;

  font-weight: bold;

  font-size: 14px;

}



.redes-sociais { display: flex; flex-wrap: wrap; gap: 15px; margin-top: 25px; }



.redes-sociais a {

  display: inline-block;

  padding: 12px 20px;

  border: 1px solid var(--dourado);

  color: var(--dourado);

  text-decoration: none;

  font-size: 13px;

  font-weight: 700;

  transition: 0.3s;

}



.redes-sociais a:hover {

  background: var(--dourado);

  color: var(--fundo);

  transform: translateY(-3px);

}



.habilidades { background: #0c1220; }



.skill {

  min-height: 155px;

  padding: 18px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  border: 1px solid var(--linha);

}



.skill h3 { font-size: 23px; font-weight: 800; margin: 12px 0 0; }

.skill small, .skill p { color: white; }

.skill p { font-size: 12px; margin: 0; }



.s1 { background: var(--azul); color: white; }

.s2 { background: var(--vermelho); color: white; }

.s3 { background: var(--dourado); color: #080b12; }

.s4 { background: #f5f5f5; color: #080b12; }



.card {

  border: 1px solid var(--linha);

  border-radius: 5px;

  background: #0c1220;

  color: var(--texto);

  overflow: hidden;

  transition: transform 0.3s, border-color 0.3s;

}



.card:hover { transform: translateY(-5px); border-color: var(--dourado); }



.capa {

  height: 150px;

  display: flex;

  align-items: center;

  justify-content: center;

  font: 13px 'DM Mono', monospace;

  letter-spacing: 2px;

}



.c1 { background: var(--vermelho); color: white; }

.c2 { background: var(--azul); color: var(--dourado); }

.c3 { background: var(--dourado); color: #080b12; }



.card-body { padding: 20px; }

.card-title { font-size: 21px; font-weight: 800; color: white; }

.card .etiqueta, .card-text { color: white; }

.card-text { font-size: 14px; }



.link-projeto {

  color: var(--dourado);

  text-decoration: none;

  font-size: 13px;

  font-weight: bold;

  border-bottom: 1px solid var(--dourado);

}



.link-projeto:hover { color: white; }



.contato { background: var(--azul); color: white; padding: 75px 0; }

.contato .etiqueta { color: var(--dourado); }

.contato-texto { color: var(--cinza); line-height: 1.8; max-width: 330px; margin-top: 20px; }

.contato-simbolo { font-size: 75px; color: var(--dourado); }

.form-label { font-size: 12px; color: white; }



.form-control {

  border: 0;

  border-bottom: 1px solid #52617a;

  border-radius: 0;

  padding: 12px 0;

  background: transparent;

  color: white;

}



.form-control:focus { background: transparent; color: white; border-color: var(--dourado); box-shadow: none; }

.form-control::placeholder { color: var(--cinza); font-size: 13px; }



footer {

  background: #05070c;

  color: white;

  padding: 22px 0 8px;

  border-top: 1px solid var(--linha);

}



footer p { font: 10px 'DM Mono', monospace; }



@media (max-width: 576px) {

  .hero { padding: 55px 0; }

  .hero h1 { letter-spacing: -1.5px; }

  .secao, .contato { padding: 50px 0; }

  .skill { min-height: 140px; padding: 13px; }

}



